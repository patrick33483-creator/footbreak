# Crown / 皇冠 — stored separately at /etc/footbreak-crown.env (mode 0600).
# Do not put credentials in git.  Crown reads existing PINNAPI_* values from
# /etc/footbreak.env first, then this file as an optional override.

# Existing paid PinnAPI Edge credential names (either is accepted):
PINNAPI_API_KEY=
# CUSTOM_CRED_PINNAPI_COM_TOKEN=
# PINNAPI_BASE_URL=https://pinnapi.com

# Validation gate.  0 means the Crown runner performs no remote request.
CROWN_ENABLED=0

# Default-off reciprocal T-5 research bridge.  Set to 1 only through the
# reviewed reverse-T5 rollout after confirming the dedicated timer is active.
# It creates isolated simulation-only records; it never enables real betting.
# Enabling records a one-time 120-second local rollout grace; then health
# requires a parseable successful worker completion no older than 90 seconds.
CROWN_REVERSE_T5_BRIDGE_ENABLED=0

# Titan007 Crown company ID.  Do not change without a documented validation.
CROWN_TITAN_COMPANY_ID=3
CROWN_SOURCE_MAX_AGE_SEC=90
# Set only after verifying the provider's timestamp behavior:
CROWN_ALLOW_INFERRED_PINNAPI_TIMESTAMP=0

# Local-only cross-book execution evidence.  Keep these authoritative defaults
# unless the writer and matching systemd ReadOnlyPaths= are changed together.
FOOTBREAK_CROWN_EXECUTION_EVIDENCE_PATH=/var/lib/footbreak/crown/footbreak-execution-evidence.json
CROWN_HKJC_EXECUTION_EVIDENCE_PATH=/opt/footbreak/system/sim_ledger.json

# Legacy Crown Telegram is permanently retired. V2 has separate controls.
CROWN_TELEGRAM_ENABLED=0
CROWN_TELEGRAM_BOT_TOKEN=
CROWN_TELEGRAM_CHAT_ID=

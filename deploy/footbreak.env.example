# ═══════════════════════════════════════════════════════════
# 足破 · 環境變數  →  複製去 /etc/footbreak.env,chmod 600
# 呢個檔案唔可以入 git。
# ═══════════════════════════════════════════════════════════

# PinnAPI Edge key is normally stored in /etc/footbreak-crown.env and is
# loaded by deploy/run.sh.  Footbreak sharp odds no longer require OpticOdds.
# PinnAPI_API_KEY=
# CUSTOM_CRED_PINNAPI_COM_TOKEN=
# PINNAPI_BASE_URL=https://pinnapi.com

# Telegram bot token —— 同 @BotFather 傾偈攞,格式 123456789:AAxxxxxxxx
# 攞到之後同個 bot 傾一句偈,再開
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private durable operational-alert state.  Alerts use the existing Telegram
# chat, send once per active incident and once after a stable recovery.
# Set to 0 for an emergency silent disable; disabled mode neither sends nor
# changes alert state.
# INCIDENT_ALERT_ENABLED=1
# INCIDENT_ALERT_STATE_PATH=/var/lib/footbreak/incident-alerts.json
# INCIDENT_T5_LOOKBACK_SECONDS=21600
# INCIDENT_SETTLEMENT_GRACE_SECONDS=14400
# INCIDENT_SETTLEMENT_ATTEMPT_MAX_AGE_SECONDS=86400
# Two confirmed failures of the same service inside this bounded window are
# required before a service alert; one successful completion resets a pending
# failure silently.
# INCIDENT_SERVICE_FAILURE_CONFIRMATION_SECONDS=129600

# ── 以下全部可選 ──────────────────────────────────────────
# 單次 HTTP 逾時秒數
# EXTERNAL_TOOL_TIMEOUT=60

# HTTP 重試次數(429 / 5xx 會退避重試)
# EXTERNAL_TOOL_RETRIES=3

# Optional private, append-only selected-odds recovery overlay.  Dashboard and
# data-health only read it; the guarded GitHub workflow is its only writer.
# Historical odds recovery is disabled by default. Existing sidecar evidence
# remains private and audit-only unless an operator explicitly opts in.
# ODDS_RECOVERY_ENABLED=0
# ODDS_RECOVERY_SIDECAR=/var/lib/footbreak/private/odds-recovery-overlay.json

# ═══════════════════════════════════════════════════════════
# 足破 · 環境變數  →  複製去 /etc/footbreak.env,chmod 600
# 呢個檔案唔可以入 git。
# ═══════════════════════════════════════════════════════════

# OpticOdds API key —— sharp.py(賠率)同 settle.py(賽果)靠佢。
# 冇呢個 key,成個系統跑唔到。喺 https://opticodds.com 申請。
OPTICODDS_API_KEY=

# Telegram bot token —— 同 @BotFather 傾偈攞,格式 123456789:AAxxxxxxxx
# 攞到之後同個 bot 傾一句偈,再開
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# 就見到你自己嘅 chat id(現時系統寫死係 703318555)。
TELEGRAM_BOT_TOKEN=

# ── 以下全部可選 ──────────────────────────────────────────
# OpticOdds 基底 URL(通常唔使改)
# OPTICODDS_BASE=https://api.opticodds.com/api/v3

# 單次 HTTP 逾時秒數
# EXTERNAL_TOOL_TIMEOUT=60

# HTTP 重試次數(429 / 5xx 會退避重試)
# EXTERNAL_TOOL_RETRIES=3

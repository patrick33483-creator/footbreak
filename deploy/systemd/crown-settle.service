[Unit]
Description=皇冠 · 獨立賽果結算及三市場準繩度更新
After=network-online.target
Wants=network-online.target
OnFailure=footbreak-incident-alert@%n.service
ConditionPathExists=!/run/crown-t5-priority

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak
Environment=FOOTBREAK_LEDGER_PATH=/opt/footbreak/system/sim_ledger.json
Environment=FOOTBREAK_RESULT_CACHE_DIR=/opt/footbreak/system/cache/results
ExecStart=/opt/footbreak/deploy/crown-run.sh settle
# The complete pass includes providers, child termination, final state-lock
# acquisition, atomic serialization, and local publication.  Reserve the last
# 30 seconds before committing, leaving the 15-minute unit limit as a true
# cgroup-only last-resort backstop.
Environment=CROWN_SETTLE_PASS_DEADLINE_SECONDS=120
Environment=CROWN_SETTLE_PROVIDER_PASS_DEADLINE_SECONDS=90
# The history reconciler falls back to Titan's exact fixture-detail endpoint
# only after the bounded schedule/official result snapshots miss. One exact ID
# is cached across all retained prediction stages. This cap lets current V2
# condition results catch up without an unbounded provider fan-out.
Environment=CROWN_HISTORY_RESULT_DETAIL_BUDGET=20
TimeoutStartSec=900
# A timeout or urgent T-5 preemption must terminate Python and every provider
# helper in this unit's cgroup. The runner lock is then released by its shell;
# no age-based lock breaking is used, so a genuinely live settlement is never
# displaced merely for being old.
KillMode=control-group
TimeoutStopSec=30
SendSIGKILL=yes
Nice=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

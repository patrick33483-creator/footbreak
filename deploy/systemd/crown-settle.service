[Unit]
Description=皇冠 · 獨立賽果結算及三市場準繩度更新
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak
ExecStart=/opt/footbreak/deploy/crown-run.sh settle
TimeoutStartSec=900
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

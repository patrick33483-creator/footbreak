[Unit]
Description=足破 · 每晚全板首預
After=network-online.target
Wants=network-online.target
OnFailure=footbreak-incident-alert@%n.service
ConditionPathExists=!/run/footbreak-t5-priority

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak/system
ExecStart=/opt/footbreak/deploy/run.sh sweep
TimeoutStartSec=3600
TimeoutStopSec=3
Nice=10

[Install]
WantedBy=multi-user.target

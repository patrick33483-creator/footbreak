[Unit]
Description=足破 · T-30 / T-5 預測執行點
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak/system
# 單一到期隊列同時處理 T-5 及 T-30，程式內已按最近開賽優先。
# 慢全板掃描或結算若仍在執行，先中止佢哋；兩者輸出均以原子替換。
ExecStartPre=/usr/bin/touch /run/footbreak-t5-priority
ExecStartPre=/usr/bin/systemctl stop footbreak-sweep.service footbreak-settle.service
ExecStart=/opt/footbreak/deploy/run.sh tick
ExecStopPost=-/usr/bin/rm -f /run/footbreak-t5-priority
# 同時開波批次需要完成所有 T-5，再補 T-30。60 秒硬上限仍保證
# 下一輪可以在落注窗口內重新抓最新資料。
TimeoutStartSec=60
TimeoutStopSec=3
Nice=5

[Install]
WantedBy=multi-user.target

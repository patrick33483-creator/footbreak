[Unit]
Description=足破 · T-30 / T-5 預測執行點
After=network-online.target
Wants=network-online.target
OnFailure=footbreak-incident-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak/system
# 單一到期隊列同時處理 T-5 及 T-30，程式內已按最近開賽優先。
# 只在真係欠一個到期 T-30 / T-5 階段時先中止慢任務。空 tick 或已
# 完成 T-30 嘅等待期唔可以反覆殺死賽果結算。
ExecStartPre=/opt/footbreak/deploy/footbreak-tick-preempt.sh
ExecStart=/opt/footbreak/deploy/run.sh tick
ExecStopPost=-/usr/bin/rm -f /run/footbreak-t5-priority
# Give a just-finishing state writer enough time to release the shared lock.
# Exit 75 is deliberate duplicate/pre-emption rejection; the timer retries.
Environment=FOOTBREAK_TICK_LOCK_WAIT_SECONDS=5
SuccessExitStatus=75
# 同時開波批次需要完成所有 T-5，再補 T-30。60 秒硬上限仍保證
# 下一輪可以在落注窗口內重新抓最新資料。
TimeoutStartSec=60
TimeoutStopSec=3
Nice=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=Classify one-hour Telegram silence across Footbreak Crown and Odds Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/footbreak
EnvironmentFile=-/etc/footbreak.env
EnvironmentFile=-/etc/footbreak-crown.env
Environment=PYTHONPATH=/opt/footbreak/system
Environment=TG_SILENCE_MONITOR_SECONDS=3600
ExecStart=/opt/footbreak/.venv/bin/python3 /opt/footbreak/system/telegram_silence_monitor.py
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=足破 · 皇冠 15-minute fixture discovery and first-look recovery
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/run/crown-t5-priority

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak
ExecStart=/opt/footbreak/deploy/crown-run.sh sweep
ExecStartPost=/opt/footbreak/.venv/bin/python3 /opt/footbreak/deploy/check-crown-first-look.py --state-dir /var/lib/footbreak/crown
TimeoutStartSec=3600
KillMode=control-group
TimeoutStopSec=30
SendSIGKILL=yes
Nice=15

[Install]
WantedBy=multi-user.target

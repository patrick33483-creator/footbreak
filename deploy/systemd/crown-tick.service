[Unit]
Description=足破 · 皇冠 T-30 / T-5 simulation tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak
ExecStartPre=/opt/footbreak/deploy/crown-tick-preempt.sh
ExecStart=/opt/footbreak/deploy/crown-run.sh tick
# The engine persists completed fixture stages independently and terminates
# overdue provider workers before this.  Keep a hard service backstop below a
# minute so an upstream fixture-list call can never block the next timer tick.
Environment=CROWN_TICK_PASS_DEADLINE_SECONDS=40
TimeoutStartSec=55
TimeoutStopSec=5
Nice=5
SuccessExitStatus=75
ExecStopPost=-/usr/bin/rm -f /run/crown-t5-priority

[Install]
WantedBy=multi-user.target

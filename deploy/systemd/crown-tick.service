[Unit]
Description=足破 · 皇冠 T-30 / T-5 simulation tick
After=network-online.target
Wants=network-online.target
OnFailure=footbreak-incident-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak
ExecStartPre=/opt/footbreak/deploy/crown-tick-preempt.sh
ExecStart=/opt/footbreak/deploy/crown-run.sh tick
# The engine persists completed fixture stages independently and terminates
# overdue provider workers before this. Keep a 25-second envelope for bounded
# state/dashboard/notification cleanup and runner incident bookkeeping.
Environment=CROWN_TICK_PASS_DEADLINE_SECONDS=30
TimeoutStartSec=55
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
Nice=5
SuccessExitStatus=75
ExecStopPost=-/usr/bin/rm -f /run/crown-t5-priority

[Install]
WantedBy=multi-user.target

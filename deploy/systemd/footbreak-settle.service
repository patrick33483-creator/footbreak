[Unit]
Description=足破 · 獨立賽果結算及準繩度更新
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/run/footbreak-t5-priority

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak/system
ExecStart=/opt/footbreak/deploy/run.sh settle
TimeoutStartSec=900
TimeoutStopSec=3
Nice=10

[Install]
WantedBy=multi-user.target

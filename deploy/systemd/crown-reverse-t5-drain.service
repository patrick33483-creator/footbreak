[Unit]
Description=足破 · 皇冠 reverse T-5 durable bridge worker
After=network-online.target
Wants=network-online.target
OnFailure=footbreak-incident-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/footbreak
# This is intentionally independent of native tick preemption and has no
# priority-marker condition: it may finish/recover a durable bridge job while
# a native T-5 tick is urgent.  The bridge's own nonblocking drain lock
# prevents duplicate consumers.
ExecStart=/opt/footbreak/deploy/crown-run.sh reverse-t5-drain
TimeoutStartSec=20
TimeoutStopSec=2
KillMode=control-group
SendSIGKILL=yes
Nice=19
NoNewPrivileges=true
PrivateTmp=true
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target

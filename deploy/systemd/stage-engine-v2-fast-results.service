[Unit]
Description=皇冠 V2 · 快速賽果同步及條件統計更新
After=network-online.target
Wants=network-online.target
OnFailure=footbreak-incident-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/footbreak.env
Environment=PYTHONPATH=/opt/footbreak
# Qualifying-match alerts are owned by the 30-second tick.  Settlement only
# refreshes scores/statistics; disabling its sender prevents duplicate alerts
# and keeps provider + projection work inside the bounded service window.
Environment=STAGE_V2_CONDITION_ALERT_ENABLED=0
WorkingDirectory=/opt/footbreak
ExecStart=/opt/footbreak/.venv/bin/python3 -m stage_engine_v2 settle --crown-data /var/www/crown/data.json --ledger /var/lib/footbreak/stage_engine_v2/ledger.json --dashboard /var/www/stage_engine_v2/data.json --condition-sent-log /var/lib/footbreak/stage_engine_v2/condition_telegram_sent.jsonl --operator-results /var/lib/footbreak/stage_engine_v2/operator_results.json --automatic-results /var/lib/footbreak/stage_engine_v2/automatic_results.json --lookback-days 7 --max-seconds 30
StandardOutput=append:/var/log/footbreak/stage-v2-fast-results.log
StandardError=append:/var/log/footbreak/stage-v2-fast-results.log
# Provider work remains capped at 30 seconds by ExecStart.  Leave enough
# headroom for the first cache backfill plus dashboard projection and
# de-duplicated Telegram delivery.
TimeoutStartSec=90s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
